import "calibration.msql"

// Plan-phase4 1a, benchmark 4 (with reference.shardml): a point write of the reference table (every copy).
workload ref_write {
    domain ref { size: 100000 }
    domain key { size: 1000000 within ref uniform }
    table kv  { rows: per key  k: key  r: key.ref }
    table ref { rows: per ref  id: ref }
    transaction ref_write weight 1 {
        let i = ref uniform
        write ref where id = $i
    }
}
