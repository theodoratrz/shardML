-- Foreign keys and verbatim constraints (Plan-sql step 4) on the bench Citus cluster, deployed by
-- bench/integration/test-examples.sh. The foreign keys are generated into fk-foreign-keys.sql and
-- applied after fk-distribution.sql: Citus rejects a foreign key to a table it has not distributed
-- yet. They cover every form the Citus rules allow (Plan-sql section 2):
--   campaigns -> companies   column-level REFERENCES, the shard keys paired, colocated (case 1),
--                            ON DELETE CASCADE on the distribution column (case 13)
--   campaigns -> countries   hash-sharded -> replicated (case 2), a column list
--   ads -> campaigns         named, composite, the shard keys paired at different positions (case 15)
-- and DEFAULT, CHECK, GENERATED, named constraints and WITH (..) options, written back verbatim.
-- fk.probe.sql checks the catalog and that each one is enforced.
CREATE TABLE companies (
    id BIGINT PRIMARY KEY,
    name TEXT NOT NULL CONSTRAINT name_not_blank CHECK (length(trim(name)) > 0),
    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE TABLE countries (
    code CHAR(2) CONSTRAINT countries_pkey PRIMARY KEY,
    name TEXT NOT NULL
);

CREATE TABLE campaigns (
    company_id BIGINT REFERENCES companies ON DELETE CASCADE,
    id BIGINT,
    country CHAR(2) REFERENCES countries (code),
    budget NUMERIC(12,2) DEFAULT 0 CHECK (budget >= 0),
    status TEXT NOT NULL DEFAULT 'draft' -- a comment, dropped
        ,
    CONSTRAINT campaigns_pkey PRIMARY KEY (company_id, id)
) WITH (fillfactor = 90);

CREATE TABLE ads (
    company_id BIGINT,
    campaign_id BIGINT NOT NULL,
    id BIGINT GENERATED BY DEFAULT AS IDENTITY,
    clicks INT NULL,
    PRIMARY KEY (company_id, id),
    CONSTRAINT ads_campaign_fkey FOREIGN KEY (campaign_id, company_id) REFERENCES campaigns (id, company_id)
        ON DELETE CASCADE
);
