/*
 * Step 1 of 2 of the Maven generation chain: the SQL language (.msql).
 *
 * This must run before GenerateShardMLMaven.mwe2, because it writes
 * model/generated/SQL.ecore, which ShardML.xtext imports by platform URI.
 * The two languages cannot share one workflow: XtextGenerator initializes
 * every configured language (parsing its grammar) before generating any of
 * them, so ShardML.xtext would be parsed while SQL.ecore does not yet exist.
 *
 * The cleaner is disabled so that step 2 does not wipe this step's output.
 *
 * The language is io.shardml.build.SQLLanguage (shardml/build-src, compiled first by the
 * compile-build-src execution in pom.xml), a StandardLanguage that makes the attributes of a
 * column's type unsettable in the inferred Ecore (SqlEcorePostProcessor, Plan-sql 11d).
 */
module io.shardml.GenerateSQLMaven

import org.eclipse.xtext.xtext.generator.*
import org.eclipse.xtext.xtext.generator.model.project.*

var rootPath = ".."

Workflow {

	component = XtextGenerator {
		cleaner = {
			enabled = false
		}
		configuration = {
			project = StandardProjectConfig {
				baseName = "shardml"
				rootPath = rootPath
				runtimeTest = {
					enabled = true
				}
				genericIde = {
					enabled = false
				}
				eclipsePlugin = {
					enabled = false
				}
				eclipsePluginTest = {
					enabled = false
				}
				createEclipseMetaData = false
			}
			code = {
				encoding = "UTF-8"
				lineDelimiter = "\n"
				fileHeader = "/*\n * generated by Xtext \${version}\n */"
				preferXtendStubs = false
			}
		}
		language = io.shardml.build.SQLLanguage {
			name = "io.shardml.SQL"
			fileExtensions = "msql"

			// SQL keywords match in any case, as in PostgreSQL (names are folded by
			// SQLValueConverters, not by the lexer). No backtracking.
			parserGenerator = {
				options = {
					ignoreCase = true
				}
			}

			serializer = {
				generateStub = false
			}
			junitSupport = {
				// As above: no SQLParsingTest stub written into tests/src.
				generateStub = false
			}
		}
	}
}
