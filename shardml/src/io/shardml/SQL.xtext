/*
 * SQL grammar
 * A lightweight ddl parser for ShardML
 * Supports a subset of CREATE TABLE statements, sufficient for sharding decisions
 * Schema files use the .msql extension and are imported by ShardML models
 * to provide table and column cross-references
 *
 * Lexing follows PostgreSQL (Plan-sql, step 2):
 *  - keywords match in any case (ignoreCase in GenerateSQLMaven.mwe2);
 *  - an unquoted name is folded to lower case and a "quoted" name is kept as written, by
 *    SQLValueConverters, so `CREATE TABLE Album` and a reference `album` are the same table;
 *  - a keyword may be a table or column name exactly when PostgreSQL allows it bare: its
 *    category in pg_get_keywords() is U or C, or it is not a PostgreSQL keyword (rule Name);
 *  - comments are -- and slash-star; strings are 'single-quoted'; statements may end in ';'.
 */

grammar io.shardml.SQL hidden(WS, ML_COMMENT, SL_COMMENT)
generate sql "http://shardml.io/SQL"

import "http://www.eclipse.org/emf/2002/Ecore" as ecore

// Root container: the statements of a schema file, each optionally ended by ';' (pg_dump input,
// Plan-sql step 5). A statement is one of:
//  - a modelled one: CREATE TABLE, ALTER TABLE .. ADD constraint (pg_dump declares every key there),
//    CREATE [UNIQUE] INDEX, CREATE SCHEMA;
//  - any other statement, kept as its words up to its ';' (Statement) and sorted by SqlStatements
//    into the pg_dump preamble the generator leaves out (SET, set_config, OWNER TO, psql
//    restrict / unrestrict lines, GRANT / REVOKE / COMMENT ON, DROP TABLE), counted in one INFO issue
//    per file, and everything else, a located error (SHML_061). Nothing is skipped silently.
// The alternatives are told apart by their first two tokens, so no backtracking is needed.
Schema:
	( ( tables += Table
	  | alters += AlterTable
	  | indexes += Index
	  | schemas += SchemaDecl
	  | statements += Statement
	  ) ';'? )*
;

// maps to database table
// columns and table constraints are comma separated (classic SQL syntax)
Table:
	'CREATE' 'TABLE' (ifNotExists ?= 'IF' 'NOT' 'EXISTS')? (schemaName=Name '.')? name=Name '('
		(columns += Column | constraints += TableConstraint)
		(',' (columns += Column | constraints += TableConstraint))*
	')' (options=TableOptions)?
;

// WITH (storage_parameter = value, ...) after a table, kept verbatim (pgbench: fillfactor)
TableOptions returns RawSql:
	kind=WithKind text=Parenthesized
;

// ALTER TABLE [IF EXISTS] [ONLY] [schema.]table, then either ADD a table constraint, merged into the
// table's keys by SchemaFacts, or any other action up to its ';' (OWNER TO, ATTACH PARTITION, ALTER
// COLUMN, ..), sorted by SqlStatements as a Statement is. Only ADD links its table (the qualifier
// must match the table's own CREATE TABLE, as in REFERENCES): pg_dump also writes ALTER TABLE ..
// OWNER TO for sequences and views, so the other actions keep the name as text (target)
AlterTable:
	'ALTER' 'TABLE' (ifExists?='IF' 'EXISTS')? only?='ONLY'? (schemaName=Name '.')?
	( table=[Table|Name] 'ADD' constraint=TableConstraint
	| target=Name body=AlterTableBody ';'
	)
;

// CREATE [UNIQUE] INDEX [IF NOT EXISTS] [name] ON [ONLY] [schema.]table [USING method] (parts)
// [INCLUDE (..)] [WITH (..)] [WHERE (..)]. A part is a column or a (parenthesized expression), each
// with its operator class, ordering and collation kept as written; the tail is verbatim. A WHERE
// predicate must be parenthesized, as pg_dump writes it
Index:
	'CREATE' unique?='UNIQUE'? 'INDEX' (ifNotExists?='IF' 'NOT' 'EXISTS')? name=Name?
	'ON' only?='ONLY'? (schemaName=Name '.')? table=[Table|Name] ('USING' method=Name)?
	'(' parts += IndexPart (',' parts += IndexPart)* ')'
	(tail=IndexTail)?
;

IndexPart:
	(column=[Column|Name] | expression=Parenthesized) (options=IndexOptions)?
;

// CREATE SCHEMA [IF NOT EXISTS] name; written back with IF NOT EXISTS
SchemaDecl:
	'CREATE' 'SCHEMA' (ifNotExists?='IF' 'NOT' 'EXISTS')? name=Name
;

// Any statement the grammar does not model: its first word, then its words as written up to its ';'
// (a dollar-quoted body may contain ';'), or a psql meta-command line. CREATE and ALTER here are
// the forms whose second word is not one of the modelled ones (TABLE, INDEX, SCHEMA), so a broken
// CREATE TABLE is a syntax error where it breaks, never an unsupported statement.
Statement:
	( verb='CREATE' body=CreateBody
	| verb='ALTER' body=AlterBody
	| verb=Verb (body=RawTokens)?
	) ';'
	| meta=PSQL_META
;

// supports zero or more constraints (primary key, unique, not null)
// Column.simpleType is unsettable (io.shardml.build.SqlEcorePostProcessor, Plan-sql 11b (a)): a
// column whose type did not parse has isSetSimpleType() false, instead of reading INT.
// Multi-word types are spelled out here, and their last keyword carries the enum literal.
Column:
	name=Name
	( simpleType=AllTypes
	| varchar=Varchar
	| numeric=Numeric
	| char=Char
	| 'DOUBLE' simpleType=DoublePrecision
	| 'TIMESTAMP' 'WITHOUT' 'TIME' simpleType=ZoneNoTz
	| 'TIMESTAMP' 'WITH' 'TIME' simpleType=ZoneTz
	)
	constraint += Constraint*
;

// The sized types. Each records which of its keywords was used, so it is written back as spelled.
// Bare NUMERIC / DECIMAL are AllTypes literals; bare VARCHAR / CHAR are syntax errors here.
Varchar:
	('VARCHAR' | varying?='CHARACTER' 'VARYING') '(' size=INT ')'
;

Numeric:
	(decimal?='DECIMAL' | 'NUMERIC') '(' precision=INT (',' scale=INT)? ')'
;

Char:
	(character?='CHARACTER' | 'CHAR') '(' size=INT ')'
;

// The single-keyword types. The first eight literals keep their place (INT stays ordinal 0); new
// ones are appended. INT / INTEGER and FLOAT / DOUBLE PRECISION are separate literals so that
// each is written back as spelled; SqlTypes knows which are the same PostgreSQL type.
enum AllTypes:
	INT='INT' | BIGINT='BIGINT' | UUID='UUID' | DECIMAL='DECIMAL' | TIMESTAMP='TIMESTAMP' | DATE='DATE' | BOOLEAN='BOOLEAN' | TEXT='TEXT'
	| INTEGER='INTEGER' | SMALLINT='SMALLINT' | SERIAL='SERIAL' | BIGSERIAL='BIGSERIAL' | NUMERIC='NUMERIC'
	| REAL='REAL' | FLOAT='FLOAT' | TIMESTAMPTZ='TIMESTAMPTZ' | JSONB='JSONB' | BYTEA='BYTEA'
;

// the last keyword of a multi-word type: DOUBLE PRECISION, TIMESTAMP WITH[OUT] TIME ZONE
enum DoublePrecision returns AllTypes: DOUBLE_PRECISION='PRECISION';
enum ZoneNoTz returns AllTypes: TIMESTAMP='ZONE';
enum ZoneTz returns AllTypes: TIMESTAMPTZ='ZONE';

// Constraints (Plan-sql 4.5, step 4). Every column and table constraint may be named
// (CONSTRAINT name ...): the name is a feature of NamedConstraint, the common supertype of Constraint
// and TableConstraint. That rule is never called; it only declares the supertype, so that ForeignKey,
// which is both a Constraint (column-level REFERENCES) and a TableConstraint (FOREIGN KEY), inherits
// one name, not two.
NamedConstraint:
	Constraint | TableConstraint
;

fragment ConstraintName returns NamedConstraint:
	('CONSTRAINT' name=Name)?
;

// column level. Forced type instantiation {Type} where a constraint has no other assignment.
Constraint:
	PrimaryAnnotation | UniqueAnnotation | NotNull | Nullable | ColumnReferences | ColumnRaw
;

PrimaryAnnotation:
	{PrimaryAnnotation} ConstraintName 'PRIMARY' 'KEY'
;

UniqueAnnotation:
	{UniqueAnnotation} ConstraintName 'UNIQUE'
;

NotNull:
	{NotNull} ConstraintName 'NOT' 'NULL'
;

// the explicit NULL constraint (the default; written back as given)
Nullable:
	{Nullable} ConstraintName 'NULL'
;

// column-level REFERENCES: a ForeignKey whose own columns list is empty; SchemaFacts fills in
// the column it is declared on
ColumnReferences returns ForeignKey:
	ConstraintName 'REFERENCES' References
;

// DEFAULT, CHECK and GENERATED, kept as written (RawSql, the one class holding original text)
ColumnRaw returns RawSql:
	ConstraintName
	( kind=DefaultKind text=DefaultExpr
	| kind=CheckKind text=Parenthesized
	| kind=GeneratedKind text=GeneratedTail
	)
;

// table level. The key columns resolve to columns of the same table (SQLScopeProvider)
TableConstraint:
	PrimaryKey | UniqueKey | ForeignKey | TableCheck
;

// columns is declared on TableConstraint itself, not lifted from its subclasses, so that TableCheck,
// which has no columns, leaves it where it was
fragment KeyColumns returns TableConstraint:
	'(' columns += [Column|Name] (',' columns += [Column|Name])* ')'
;

PrimaryKey:
	ConstraintName 'PRIMARY' 'KEY' KeyColumns
;

UniqueKey:
	ConstraintName 'UNIQUE' KeyColumns
;

ForeignKey:
	ConstraintName 'FOREIGN' 'KEY' KeyColumns 'REFERENCES' References
;

TableCheck:
	ConstraintName check=CheckClause
;

CheckClause returns RawSql:
	kind=CheckKind text=Parenthesized
;

// what follows REFERENCES. The referenced table is named without its schema (refSchema holds the
// qualifier, if written); no column list means the referenced table's primary key. Each action
// at most once, in either order, as in PostgreSQL. ON DELETE SET NULL (columns) is not supported.
fragment References returns ForeignKey:
	(refSchema=Name '.')? refTable=[Table|Name]
	('(' refColumns += [Column|Name] (',' refColumns += [Column|Name])* ')')?
	('MATCH' match=MatchKind)?
	(OnDelete OnUpdate? | OnUpdate OnDelete?)?
	(deferrable=Deferrability)?
;

fragment OnDelete returns ForeignKey:
	'ON' 'DELETE' (onDelete=RefAction | 'NO' onDelete=NoAction | 'SET' onDelete=SetAction)
;

fragment OnUpdate returns ForeignKey:
	'ON' 'UPDATE' (onUpdate=RefAction | 'NO' onUpdate=NoAction | 'SET' onUpdate=SetAction)
;

// the actions; NO ACTION and SET NULL / SET DEFAULT are spelled out, their last keyword carries the
// literal. ForeignKey.onDelete / onUpdate / match are unsettable (SqlEcorePostProcessor): unset
// means not written
enum RefAction: CASCADE='CASCADE' | RESTRICT='RESTRICT';
enum NoAction returns RefAction: NO_ACTION='ACTION';
enum SetAction returns RefAction: SET_NULL='NULL' | SET_DEFAULT='DEFAULT';

enum MatchKind: SIMPLE='SIMPLE' | FULL='FULL';

// the keyword of each kind of verbatim text
enum DefaultKind returns RawKind: DEFAULT='DEFAULT';
enum CheckKind returns RawKind: CHECK='CHECK';
enum GeneratedKind returns RawKind: GENERATED='GENERATED';
enum WithKind returns RawKind: WITH='WITH';

// Verbatim text. These rules only delimit it: the value is the source text of the rule's tokens,
// with comments dropped and whitespace between tokens collapsed to one space (SQLValueConverters).
// Parentheses are balanced and there is no top-level ';', so the text never runs into the next
// clause or statement.

// [NOT] DEFERRABLE [INITIALLY DEFERRED | IMMEDIATE], in PostgreSQL's two orders
Deferrability:
	'NOT'? 'DEFERRABLE' ('INITIALLY' ('DEFERRED' | 'IMMEDIATE'))?
	| 'INITIALLY' ('DEFERRED' | 'IMMEDIATE') ('NOT'? 'DEFERRABLE')?
;

// ALWAYS | BY DEFAULT AS IDENTITY [( sequence options )], or ALWAYS AS ( expression ) STORED.
// PostgreSQL 18's VIRTUAL is a syntax error: the bench cluster runs PostgreSQL 17.
GeneratedTail:
	('ALWAYS' | 'BY' 'DEFAULT') 'AS' ('IDENTITY' Parenthesized? | Parenthesized 'STORED')
;

// DEFAULT's expression (PostgreSQL's b_expr): tokens and parenthesized groups up to the next
// column constraint or the end of the column. NULL may only come first (DEFAULT NULL); later
// it starts the NULL constraint, as do the other constraint keywords, none of which is an
// ExprToken
DefaultExpr:
	(ExprToken | 'NULL') ExprToken*
;

ExprToken:
	ExprName | STRING | INT | ANY_OTHER | '.' | 'WITH' | Parenthesized
;

Parenthesized:
	'(' InnerToken* ')'
;

// inside parentheses: any token but ';' and unbalanced parentheses
InnerToken:
	Atom | Parenthesized
;

// any one token but ';' and the parentheses: every keyword of this grammar is a Name or listed here
Atom:
	Name | STRING | INT | ANY_OTHER | DOLLAR_STRING | '.' | ','
	| 'CREATE' | 'TABLE' | 'NOT' | 'NULL' | 'PRIMARY' | 'UNIQUE' | 'WITH' | 'CONSTRAINT' | 'FOREIGN'
	| 'REFERENCES' | 'ON' | 'DEFAULT' | 'FULL' | 'DEFERRABLE' | 'INITIALLY' | 'CHECK' | 'AS'
	| 'ONLY' | 'USING' | 'WHERE'
;

// the words of a statement the grammar does not model, up to its ';': any token, parentheses
// unbalanced or not
RawTokens:
	RawToken+
;

RawToken:
	Atom | '(' | ')'
;

// after CREATE: not TABLE, INDEX, UNIQUE or SCHEMA (FUNCTION, VIEW, SEQUENCE, TYPE, .. are no keywords here)
CreateBody:
	ID RawToken*
;

// after ALTER: not TABLE (SCHEMA, INDEX, SEQUENCE, FUNCTION, DEFAULT PRIVILEGES, ..)
AlterBody:
	(ID | 'SCHEMA' | 'INDEX' | 'DEFAULT') RawToken*
;

// after ALTER TABLE t: not ADD (OWNER TO, ATTACH PARTITION, ALTER COLUMN, SET .., DROP ..)
AlterTableBody:
	(ID | 'ALTER' | 'SET') RawToken*
;

// the first word of any other statement (SET, SELECT, GRANT, DROP, COMMENT, BEGIN, ..), or a stray
// character: the rest of a body in an unsupported $tag$ quote, cut at its first ';', is read as
// statements up to the closing $tag$; (located errors), not as the end of the file
Verb:
	ID | 'SET' | 'UPDATE' | 'DELETE' | ANY_OTHER
;

// an index part's operator class, ASC / DESC, NULLS FIRST / LAST, COLLATE ..: up to its ',' or ')'
IndexOptions:
	(Name | STRING | '.' | Parenthesized)+
;

IndexTail:
	'INCLUDE' Parenthesized ('WITH' Parenthesized)? ('WHERE' Parenthesized)?
	| 'WITH' Parenthesized ('WHERE' Parenthesized)?
	| 'WHERE' Parenthesized
;

// A table or column name: an identifier, a "quoted identifier", or a keyword of this grammar
// that PostgreSQL accepts as a bare name (category U or C in pg_get_keywords(), or not a
// PostgreSQL keyword at all). Reserved words (CREATE, TABLE, PRIMARY, UNIQUE, NOT, NULL) are
// not names here either, as in PostgreSQL; quoted, they are. WITH (of TIMESTAMP WITH TIME ZONE) is
// reserved too. SqlKeywordTest checks this list
// against the PostgreSQL 17 keyword golden. Every word that starts a constraint is reserved,
// so a column and a constraint are told apart by their first token.
Name:
	ExprName | 'GENERATED'                                                         // U
;

// every Name but GENERATED, which starts a column constraint and so cannot continue a DEFAULT
ExprName:
	ID | QUOTED_ID
	| 'KEY' | 'TEXT' | 'IF' | 'EXISTS'                                                   // U, U, U, C
	| 'INT' | 'BIGINT' | 'DECIMAL' | 'TIMESTAMP' | 'BOOLEAN' | 'VARCHAR'                 // C
	| 'INTEGER' | 'SMALLINT' | 'NUMERIC' | 'REAL' | 'FLOAT' | 'PRECISION'                // C
	| 'CHAR' | 'CHARACTER' | 'TIME'                                                      // C
	| 'DOUBLE' | 'VARYING' | 'WITHOUT' | 'ZONE'                                          // U
	| 'UUID' | 'DATE' | 'SERIAL' | 'BIGSERIAL' | 'TIMESTAMPTZ' | 'JSONB' | 'BYTEA'       // not PostgreSQL keywords
	| 'DELETE' | 'UPDATE' | 'CASCADE' | 'RESTRICT' | 'NO' | 'ACTION' | 'SET' | 'MATCH'    // U
	| 'SIMPLE' | 'DEFERRED' | 'IMMEDIATE' | 'ALWAYS' | 'BY' | 'IDENTITY' | 'STORED'       // U
	| 'ALTER' | 'ADD' | 'INDEX' | 'SCHEMA' | 'INCLUDE'                                   // U
;

// PostgreSQL's identifier characters (ASCII); no ^ escape, a keyword is quoted instead
terminal ID: ('a'..'z'|'A'..'Z'|'_') ('a'..'z'|'A'..'Z'|'_'|'0'..'9'|'$')*;
// "Order", "bıgınt": kept as written, "" stands for one "
terminal QUOTED_ID: '"' ('""' | !'"')* '"';
// SQL strings: single quotes, '' stands for one '
terminal STRING: "'" ("''" | !"'")* "'";
terminal INT returns ecore::EInt: ('0'..'9')+;
// a dollar-quoted string (function bodies) with the tags pg_dump writes: $$, else $_$, else $__$
// (it adds '_' until the tag is not in the body). Other tags ($body$ .. $body$) are not supported: a
// lexer rule cannot match a closing tag to its opening one
terminal DOLLAR_STRING: '$$' -> '$$' | '$_$' -> '$_$' | '$__$' -> '$__$';
// a psql meta-command (a backslash, then the rest of its line)
terminal PSQL_META: '\\' !('\n'|'\r')*;
terminal ML_COMMENT: '/*' -> '*/';
terminal SL_COMMENT: '--' !('\n'|'\r')* ('\r'? '\n')?;
terminal WS: (' '|'\t'|'\r'|'\n')+;
terminal ANY_OTHER: .;
