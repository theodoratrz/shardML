/*
 * A DMSL for designing and validating database sharding configurations.
 * Imports existing SQL schema and allow engineers to declare sharding
 * strategies, query patterns and table relationships.
 * Output is generated for PostgreSQL (Citus). 'mysql' still parses so the
 * validator can reject it with a clear message (SHML_025).
 * 
 */

grammar io.shardml.ShardML with org.eclipse.xtext.common.Terminals

generate shardML "http://shardml.io/ShardML"

// Cross grammar reference to the SQL metamodel
import "platform:/resource/shardml/model/generated/SQL.ecore" as sql

// Root model, exaclty 1 database declaration
Model:
	imports += Import*
    db = Database
;

// reference an external .msql schema file by URI
Import:
	'import' importURI=STRING
;

// Top level container for all sharding config
Database:
    'database' name=ID '{'
    'type:' type = DatabaseType
    shard_decl += ShardDecl*
    route_rules += RouteRule*
    relationships += Relationship* '}'
;

// Target platforms; only postgres is supported
enum DatabaseType:
    POSTGRES='postgres' | MYSQL='mysql'
;

// Used by validators to check that related tables are colocated
// should mirror application's data model
Relationship:
    HasMany|HasOne|BelongsTo
;

HasMany:
    subject=[sql::Table] 'has_many' many=[sql::Table]
;

HasOne:
    subject=[sql::Table] 'has_one' one = [sql::Table]
;

BelongsTo:
    subject=[sql::Table] 'belongs_to' belongs = [sql::Table]
;

// Defines how a table is distributed across shards
// hash and consistent hasg strategies require a shard key and bucket count
// replicated tables are copied to every shard
// colocate_with: groups this table with another on the same shard, for efficient joins
ShardDecl:
    'shard' entity=[sql::Table] '{'
    'strategy:' strategy = Strategy
    ('key:' id=[sql::Column])?
    ('buckets:' buckets=INT)?
    ('colocate_with:' colocate=[sql::Table])? '}'
;

enum Strategy:
    HASH='hash'|CONS_HASH='consistent_hash'|REPLICATED='replicated'
;

// Declares the expected query patterns for a table
// the policy controls how violations are reported:
// allow: supress warnings
// warn: issue warnings
// deny: treat the as errors
// max_conditions: limits where clause complexity
RouteRule:
    'route' entity=[sql::Table] '{'
    'policy:' policy=Policy
    ('max_conditions:' condtions=INT)? queries += QueryPattern*
    '}'
;

enum Policy:
    ALLOW='allow'|WARN='warn'|DENY='deny'
;

// High level description of a query
// rather than raw SQL, we declare the query type and structural 
// clauses (where, sort, group by, distinct). 
// This gives the validator enough info to reason about scatter-gather 
// without requiring a full query
QueryPattern:
    'query' name=ID '{'
    'type:' queryType=QueryType
    ('where:' where=WhereClause)?
    ('sort:' sort=SortClause)?
    ('group_by:' group=GroupBy)?
    ('distinct:' distinct?='true')?
    '}'
;

// delete without a where is always an error
// read an write respect the policy defined
enum QueryType:
    READ='read'|WRITE='write'|DELETE='delete'
;

WhereClause:
    first=WhereCondition ( link+=Link rest+=WhereCondition )*
;

WhereCondition:
    field=[sql::Column] op=Operator '?'
;

enum Operator:
    EQ='='|GE='>'|LE='<'|LEQ='<='|GEQ='>='|NEQ='!='
;

enum Link:
    AND='AND'|OR='OR'
;

SortClause:
    field=[sql::Column] order=SortOrder
;

enum SortOrder:
    ASC='ASC'|DESC='DESC'
;

GroupBy:
    field=[sql::Column]
;