/*
 * Step 3 of 3 of the Maven generation chain: the workload language (.workload).
 * Requires GenerateSQLMaven.mwe2 to have run first: Workload.xtext imports
 * SQL.ecore. It does not depend on ShardML; it runs last only to keep one order.
 *
 * Same project configuration as step 2: runtime and runtimeTest only, no Eclipse
 * metadata, cleaner off so the earlier steps' output in src-gen survives.
 */
module io.shardml.GenerateWorkloadMaven

import org.eclipse.emf.mwe.utils.*
import org.eclipse.xtext.xtext.generator.*
import org.eclipse.xtext.xtext.generator.model.project.*

var rootPath = ".."

Workflow {

	// A new JVM again, so the SQL GenModel is registered again (see step 2)
	bean = StandaloneSetup {
		projectMapping = {
			projectName = "shardml"
			path = "${rootPath}/shardml"
		}
		registerGenModelFile = "platform:/resource/shardml/model/generated/SQL.genmodel"
	}

	component = XtextGenerator {
		cleaner = {
			enabled = false
		}
		configuration = {
			project = StandardProjectConfig {
				baseName = "shardml"
				rootPath = rootPath
				runtimeTest = {
					enabled = true
				}
				genericIde = {
					enabled = false
				}
				eclipsePlugin = {
					enabled = false
				}
				eclipsePluginTest = {
					enabled = false
				}
				createEclipseMetaData = false
			}
			code = {
				encoding = "UTF-8"
				lineDelimiter = "\n"
				fileHeader = "/*\n * generated by Xtext \${version}\n */"
				preferXtendStubs = false
			}
		}
		language = StandardLanguage {
			name = "io.shardml.Workload"
			fileExtensions = "workload"

			serializer = {
				generateStub = false
			}
			validator = {
				generateDeprecationValidation = true
				generateXtendStub = false
			}
			scopeProvider = {
				generateXtendStub = false
			}
			// a workload generates nothing; the cost model reads it
			generator = {
				generateStub = false
			}
			junitSupport = {
				junitVersion = "5"
				generateStub = false
			}
		}
	}
}
