/*
 * Step 2 of 2 of the Maven generation chain: the ShardML language (.shardml).
 * Requires GenerateSQLMaven.mwe2 to have run first — see the note there.
 *
 * Project configuration:
 *   - only the runtime and runtimeTest projects are generated; genericIde /
 *     eclipsePlugin / eclipsePluginTest are disabled, as there is no editor.
 *   - createEclipseMetaData = false: no MANIFEST.MF / build.properties / plugin.xml.
 *   - the cleaner is off, so step 1's output in src-gen survives.
 */
module io.shardml.GenerateShardMLMaven

import org.eclipse.emf.mwe.utils.*
import org.eclipse.xtext.xtext.generator.*
import org.eclipse.xtext.xtext.generator.model.project.*

var rootPath = ".."

Workflow {

	/*
	 * Step 1 registered the SQL GenModel in its own JVM; this run is a new JVM,
	 * so it has to be registered again. Without it, EMF cannot resolve the
	 * sql::Table / sql::Column references and generates no ShardML GenModel.
	 */
	bean = StandaloneSetup {
		// An explicit mapping, not platformUri: that scans for .project files,
		// which this repository gitignores, so nothing would be registered.
		projectMapping = {
			projectName = "shardml"
			path = "${rootPath}/shardml"
		}
		registerGenModelFile = "platform:/resource/shardml/model/generated/SQL.genmodel"
	}

	component = XtextGenerator {
		cleaner = {
			enabled = false
		}
		configuration = {
			project = StandardProjectConfig {
				baseName = "shardml"
				rootPath = rootPath
				runtimeTest = {
					enabled = true
				}
				genericIde = {
					enabled = false
				}
				eclipsePlugin = {
					enabled = false
				}
				eclipsePluginTest = {
					enabled = false
				}
				createEclipseMetaData = false
			}
			code = {
				encoding = "UTF-8"
				lineDelimiter = "\n"
				fileHeader = "/*\n * generated by Xtext \${version}\n */"
				preferXtendStubs = false
			}
		}
		language = StandardLanguage {
			name = "io.shardml.ShardML"
			fileExtensions = "shardml"

			serializer = {
				generateStub = false
			}
			validator = {
				generateDeprecationValidation = true
				// Java stubs, so the fragment finds ShardMLValidator.java (and the
				// scope provider and generator below) and leaves them alone.
				generateXtendStub = false
			}
			scopeProvider = {
				generateXtendStub = false
			}
			generator = {
				generateXtendStub = false
			}
			junitSupport = {
				junitVersion = "5"
				// Only the injector providers in src-gen; no example test stub,
				// the real tests are hand-written.
				generateStub = false
			}
		}
	}
}
