<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="sql" nsURI="http://www.ac.uk/kcl/inf/mdd1/SQL" nsPrefix="sql">
  <eClassifiers xsi:type="ecore:EClass" name="Schema">
    <eStructuralFeatures xsi:type="ecore:EReference" name="tables" upperBound="-1"
        eType="#//Table" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Table">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="columns" upperBound="-1"
        eType="#//Column" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Column">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="simpleType" eType="#//AllTypes"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="varchar" eType="#//Varchar"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="constraint" upperBound="-1"
        eType="#//Constraint" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Varchar">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="size" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="AllTypes">
    <eLiterals name="INT" literal="INT"/>
    <eLiterals name="BIGINT" value="1" literal="BIGINT"/>
    <eLiterals name="UUID" value="2" literal="UUID"/>
    <eLiterals name="DECIMAL" value="3" literal="DECIMAL"/>
    <eLiterals name="TIMESTAMP" value="4" literal="TIMESTAMP"/>
    <eLiterals name="DATE" value="5" literal="DATE"/>
    <eLiterals name="BOOLEAN" value="6" literal="BOOLEAN"/>
    <eLiterals name="TEXT" value="7" literal="TEXT"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Constraint"/>
  <eClassifiers xsi:type="ecore:EClass" name="PrimaryAnnotation" eSuperTypes="#//Constraint"/>
  <eClassifiers xsi:type="ecore:EClass" name="UniqueAnnotation" eSuperTypes="#//Constraint"/>
  <eClassifiers xsi:type="ecore:EClass" name="NotNull" eSuperTypes="#//Constraint"/>
</ecore:EPackage>
