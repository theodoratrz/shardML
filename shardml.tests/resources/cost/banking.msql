/* Plan-phase3 5.A: the banking schema of the cost examples. Every primary key holds both the
 * customer and the account column, so both layouts (by customer, by account) pass SHML_024. */
CREATE TABLE customers (
    id BIGINT PRIMARY KEY,
    name TEXT
)

CREATE TABLE accounts (
    id BIGINT,
    customer_id BIGINT,
    balance NUMERIC(12, 2),
    PRIMARY KEY (customer_id, id)
)

CREATE TABLE transactions (
    id BIGINT,
    account_id BIGINT,
    customer_id BIGINT,
    amount NUMERIC(12, 2),
    PRIMARY KEY (customer_id, account_id, id)
)

CREATE TABLE cards (
    id BIGINT,
    customer_id BIGINT,
    PRIMARY KEY (customer_id, id)
)
