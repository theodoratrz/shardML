import "banking.msql"

// Plan-phase3 5.A, layout A: accounts by id and transactions by account_id (colocated), customers by
// id and cards by customer_id (colocated): two roots of the same shape.
database banking_by_account {
    type: postgres

    node w2 { host: "worker2" port: 5432 }
    node w3 { host: "worker3" port: 5432 }
    node w1 { host: "worker1" port: 5432 }

    shard customers { strategy: hash key: id buckets: 32 }
    shard cards { strategy: hash key: customer_id buckets: 32 colocate_with: customers }
    shard accounts { strategy: hash key: id buckets: 32 }
    shard transactions { strategy: hash key: account_id buckets: 32 colocate_with: accounts }

    cards belongs_to customers via customer_id
    transactions belongs_to accounts via account_id
}
