import "social.msql"

database social {
    type: postgres

    shard users {
        strategy: hash
        key: id
        buckets: 32
    }

    shard posts {
        strategy: hash
        key: user_id
        buckets: 32
        colocate_with: users
    }

    shard comments {
        strategy: hash
        key: user_id
        buckets: 32
        colocate_with: posts
    }

    shard likes {
        strategy: hash
        key: user_id
        buckets: 32
        colocate_with: users
    }

    shard countries {
        strategy: replicated
    }

    route posts {
        policy: warn

        query FindPostsByUser {
            type: read
            where: user_id = ?
        }

        query FindAllPosts {
            type: read
        }

        query FindPostsSortedByDate {
            type: read
            where: user_id = ?
            sort: created_at ASC
        }

        query GroupPostsByDate {
            type: read
            group_by: created_at
        }
    }

    route comments {
        policy: deny

        /*query FindCommentsByPost {
            type: read
            where: post_id = ?
        }

        query DeleteAllComments {
            type: delete
        }*/
    }

    posts belongs_to users
    comments belongs_to posts
    likes belongs_to users
}